        "de" : { "stringUnit" : { "state" : "translated", "value" : "Swiftly Music sucht deinen Musikserver und deine Sonos-Lautsprecher im Heimnetz. Ohne das erreicht die App keinen Server unter einer Adresse wie 192.168.1.5 und findet keine Lautsprecher." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Swiftly Music looks for your music server and your Sonos speakers on your home network. Without this, the app cannot reach a server at an address like 192.168.1.5 and finds no speakers." } }
