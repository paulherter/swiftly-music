    "Auf %@ läuft jetzt etwas anderes. Deine Musik steht hier bereit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something else is playing on %@ now. Your music is ready here."
          }
        }
      }
    },
    "Auf deinem Server gibt es sonst nichts von %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There’s nothing else by %@ on your server."
          }
        }
