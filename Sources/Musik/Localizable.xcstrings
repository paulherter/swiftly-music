    "Andere Geräte gehen nur mit Jellyfin. Deine Schlange liegt aber auf dem Server, am nächsten Gerät machst du da weiter.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other devices only work with Jellyfin. Your queue is still on the server, so you pick up where you left off on your next device."
          }
        }
      }
    },
