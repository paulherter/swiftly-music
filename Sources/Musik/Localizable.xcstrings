    },
    "Das Lied steht schon in „%@“.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This song is already in “%@”."
          }
        }
      }
    },
    "Das gibt es auf dem Server nicht mehr.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's no longer on the server."
          }
        }
      }
    },
    "Das hat nicht geklappt": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn't work"
          }
        }
      }
    },
    "Der Server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server"
          }
        }
      }
    },
    "Der Server antwortet nicht": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server isn't answering"
          }
        }
      }
    },
    "Der Server hat einen Fehler gemeldet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server reported an error."
          }
        }
      }
    },
    "Der Server hat gerade keine.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server has none right now."
          }
        }
      }
    },
    "Der Server lässt diese Art der Anmeldung nicht zu.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server doesn't allow this way of signing in."
          }
        }
      }
    },
    "Der Server meldet: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server says: %@"
          }
        }
      }
    },
    "Der Server war nicht erreichbar. Hat Swiftly Music die Erlaubnis, Geräte im heimischen Netz zu suchen? Sie steht in den Einstellungen unter „Swiftly Music · Lokales Netzwerk“.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server couldn't be reached. Is Swiftly Music allowed to find devices on your home network? You'll find it in Settings under “Swiftly Music · Local Network”."
          }
        }
      }
    },
    "Die Adresse deines Musikservers. Du bleibst bei allen Konten angemeldet und wechselst auf der Kontoseite.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address of your music server. You stay signed in to every account and switch on the account page."
          }
        }
      }
    },
    "Die Adresse konnte nicht gelesen werden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The address couldn't be read."
          }
        }
      }
    },
    "Die Anmeldung gilt nicht mehr. Bitte neu anmelden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sign-in is no longer valid. Please sign in again."
          }
        }
      }
    },
    "Die Anmeldung von %@ gilt nicht mehr. Jetzt angemeldet als %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in for %1$@ has expired. Now signed in as %2$@."
          }
        }
      }
    },
    "Die Antwort des Servers war unverständlich.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server's answer couldn't be understood."
          }
        }
      }
    },
    "Die Datei, wie sie auf dem Server liegt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file as it is on your server."
          }
        }
      }
    },
    "Die Lieder bleiben, nur das Herz geht weg.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The songs stay, only the heart goes."
          }
        }
      }
    },
    "Die Lieder lassen sich jederzeit neu laden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can download the songs again at any time."
          }
        }
      }
    },
    "Die Playlist ist dann auch auf dem Server weg. Die Lieder bleiben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The playlist will be gone from your server too. The songs stay."
          }
        }
      }
    },
    "Die Playlist ist leer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This playlist is empty"
          }
        }
      }
    },
    "Die Schlange auf %@ lässt sich von hier nicht umstellen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The queue on %@ can't be rearranged from here."
          }
        }
      }
    },
    "Die Schlange von %@ ließ sich nicht laden.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't load the queue from %@."
          }
        }
      }
    },
    "Die geladene Musik bleibt auf dem iPhone und ist wieder da, wenn du dich mit diesem Konto anmeldest.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your downloaded music stays on this iPhone and is back when you sign in with this account."
          }
        }
      }
    },
    "Die letzte Stunde, ohne Zugangsdaten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last hour, without sign-in details"
          }
        }
      }
    },
    "Dieses Konto darf das nicht.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account isn't allowed to do that."
          }
        }
      }
    },
