{
  "sourceLanguage": "de",
  "strings": {
    "%@ antwortet nicht. Läuft er noch, oder hängt das WLAN?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn’t answering. Is it still running, or is the Wi-Fi stuck?"
          }
        }
      }
    },
    "%@ hat nicht reagiert.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ didn't respond."
          }
        }
      }
    },
    "%@ ist nicht mehr da. Die Musik steht hier bereit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is gone. Your music is ready here."
          }
        }
      }
    },
    "%@ kommt nicht an deinen Server. Der Lautsprecher holt die Musik selbst, der Server muss also in seinem Netz erreichbar sein.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ can’t reach your server. The speaker fetches the music itself, so the server has to be reachable from its network."
          }
        }
      }
    },
    "%@ ließ sich nicht allein stellen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t play on %@ alone."
          }
        }
      }
    },
    "%@ ließ sich nicht aus der Gruppe nehmen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t take %@ out of the group."
          }
        }
      }
    },
    "%@ ließ sich nicht dazuholen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t add %@."
          }
        }
      }
    },
