    "Code eingeben, dann geht es hier von selbst weiter": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the code, and this screen moves on by itself"
          }
        }
      }
    },
    "Danach gilt dein nächstes Konto. Die geladene Musik bleibt auf dem iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next account takes over. Downloaded music stays on the iPhone."
          }
        }
      }
    },
    "Danach kommt nichts mehr.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing comes after this."
          }
        }
      }
    },
    "Danach Ähnliches spielen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep playing similar music"
          }
        }
      }
    },
    "Das Album ist leer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This album is empty"
